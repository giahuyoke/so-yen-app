{
  "name": "so-yen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "emulators": "npx -y firebase-tools@latest emulators:start --only auth,firestore --project demo-so-yen",
    "test": "vitest run tests/unit",
    "seed:demo": "tsx --tsconfig tsconfig.json scripts/seed-demo.ts",
    "test:emulator": "npx -y firebase-tools@latest emulators:exec --only auth,firestore --project demo-so-yen \"vitest run tests/integration tests/rules --no-file-parallelism\""
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
